let input = read_stdin().nums.map(Number);

fn find_start(target) {
    for gg in input.sorted.reversed.prefixes {
        if sum(gg) > target {
            return gg.len;
        }
    }

    panic("nothing found");
}

fn solve(size) {
    let tar = input.sum / size;
    let start = find_start(tar);
    let best = Number(Inf);

    for size in (start..) {
        for group in input.combinations(size), if group.sum == tar {
            best min= group.product;
        }

        if best != Inf { return best };
    }

    return best;
}

solve(3).print;
solve(4).print;
