let input = read_file("input/2016/12.txt").lines;

fn code(a, b, c, d) {
	a = 1;
	b = 1;
	d = 26;

	if c != 0 { // part 2
		d += 7; 
		c = 0;
	} 

	// 33 times for part 2
	// 26 times for part 1

	for _ in 0..d {
		c = a;
		a += b;
		b = c;

		print(a, b, c);
	}

	a += 196;

  return a, b, 0, 0;
}

print(code(0, 0, 0, 0));
print(code(0, 0, 1, 0));

fn dump(mem) {
	let buf = "[";
	for reg in "abcd" {
		buf <>= reg <> ": " <> mem[reg] <> ", ";
	}
	buf <>= "]";
	print(buf);
}

fn run(input, mem) {
	let ip = 0;

	while ip < input.len {
		let ins = input[ip].words;
		dump(mem);
		ip += 1;

		if ins[0] == "cpy" {
			if ins[1] in "abcd" {
				mem[ins[2]] = mem[ins[1]];
			} else {
				mem[ins[2]] = ins[1].int;
			}
		} else if ins[0] == "inc" {
			mem[ins[1]] += 1;
		} else if ins[0] == "dec" {
			mem[ins[1]] -= 1;
		} else if ins[0] == "jnz" {
			let x = if ins[1] in "abcd" {
				mem[ins[1]]
			} else {
				ins[1].int
			};

			let y = if ins[2] in "abcd" {
				mem[ins[2]]
			} else {
				ins[2].int
			};

			if x != 0 {
				ip += (y - 1);
			}
		}
	}

	return mem;
}

