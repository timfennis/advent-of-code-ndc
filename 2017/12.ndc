let graph = %{ n[0]: n[1..] for n in read_file("input/2017/12.txt").lines.map(nums) };

fn solve(id) {
  let seen = %{};

  fn solve_inner(id) {
    seen.insert(id);
    for v in graph[id], if v not in seen {
      solve_inner(v)
    }

    seen
  }

  solve_inner(id)
}

print("Part 1:", solve(0).len);

let p2, seen = 0, %{};

for id in 0..2000, if id not in seen {
  seen |= solve(id);
  p2 += 1;
}

print("Part 2:", p2);
