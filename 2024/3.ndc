let input = read_file("input/2024/3.txt");

let p1 = 0;
let p2 = 0;

let mul = true;
for ins in input.captures(r"(mul\((\d+),(\d+)\))|(do\(\))|(don\'t\(\))") {
	if ins[0].starts_with("mul") {
        let b, c = ins[2..].map(int) as List<Int>;
		if mul {
			p2 += b * c;
		}
		p1 += b * c;
	} else if ins[0].starts_with("don't") {
		mul = false;
	} else {
		mul = true;
	}
}

print(p1, p2);