let input = read_stdin().trim;
let patterns, designs = input.paragraphs;
let designs = designs.lines;
let patterns = patterns.split(", ");

pure fn is_possible(design) -> Bool {
  if design == "" { return true; }

  let possible = false;
  for pat in patterns {
    if design.starts_with(pat) {
       possible |= is_possible(design[(pat.len)..]);
    }
  }

  return possible;
}

designs.count(is_possible).print;
