let lines = read_stdin().lines.map(int);

let nums = [];
let len = lines.len();
let idx, sum = 0, 0;

for idx in 0..len {
  sum += lines[idx];
  nums.push(sum);
}

print("Part 1: ", sum);

while true {
  sum += lines[idx % len];
  
  if sum in nums { 
    break;
  }

  idx += 1;
}

print("Part 2: ", sum);

